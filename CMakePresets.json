{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31
  },
  "configurePresets": [
    {
      "name": "base-multi",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/${presetName}/generators/conan_toolchain.cmake",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "linux",
      "inherits": "base-multi",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL - 24.04"
        }
      }
    },
    {
      "name": "windows",
      "inherits": "base-multi",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug-all",
      "configurePreset": "linux",
      "configuration": "Debug",
      "targets": "all"
    },
    {
      "name": "linux-release-all",
      "configurePreset": "linux",
      "configuration": "RelWithDebInfo",
      "targets": "all"
    },
    {
      "name": "windows-debug-all",
      "configurePreset": "windows",
      "configuration": "Debug",
      "targets": "all"
    },
    {
      "name": "windows-release-all",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "targets": "all"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug-all",
      "configurePreset": "linux",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release-all",
      "configurePreset": "linux",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug-all",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release-all",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux-debug-all"
        },
        {
          "type": "test",
          "name": "linux-debug-all"
        }
      ]
    },
    {
      "name": "linux-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux-release-all"
        },
        {
          "type": "test",
          "name": "linux-release-all"
        }
      ]
    },
    {
      "name": "windows-debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-debug-all"
        },
        {
          "type": "test",
          "name": "windows-debug-all"
        }
      ]
    },
    {
      "name": "windows-release",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-release-all"
        },
        {
          "type": "test",
          "name": "windows-release-all"
        }
      ]
    }
  ]
}
