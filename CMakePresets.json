{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31
  },
  "configurePresets": [
    {
      "name": "base-multi",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "conan/conan_provider.cmake",
        "CMAKE_CXX_FLAGS": "/external:W0 /fp:fast /EHsc",
        "CONAN_BUILD_PROFILE": "${sourceDir}/conan/linux_profile",
        "BUILD_TESTING": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "common-linux",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "make",
        "CMAKE_CXX_COMPILER": "$env{HOME}/reflection/bin/clang++",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_CXX_FLAGS": "-nostdinc++ -freflection-latest -fexpansion-statements -Wall -Wextra -Wc++26-extensions -mmmx -msse -msse2 -pedantic",
        "CMAKE_CXX_STANDARD_LIBRARIES": "-lc++ -lc++abi -L$env{HOME}/reflection/lib/x86_64-unknown-linux-gnu/libc++.so -L$env{HOME}/reflection/lib/x86_64-unknown-linux-gnu/libc++abi.so",
        "CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES": "$env{HOME}/reflection/include/c++/v1/;$env{HOME}/reflection/include/x86_64-unknown-linux-gnu/c++/v1/;/usr/lib/llvm-20/lib/clang/20/include",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "cmake/modules/conan_provider.cmake",
        "CONAN_HOST_PROFILE": "${sourceDir}/conan/profile-host-${presetName}",
        "CONAN_BUILD_PROFILE": "${sourceDir}/conan/profile-host-${presetName}",
        "BUILD_TESTING": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL - 24.04"
        }
      }
    },
    {
      "name": "linux-debug",
      "inherits": [
        "common-linux"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -fno-omit-frame-pointer"
      }
    },
    {
      "name": "linux-release",
      "inherits": [
        "common-linux"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-march=native -O3 -ffast-math -ftree-vectorize"
      }
    },
    {
      "name": "linux-relwithdebinfo",
      "inherits": [
        "common-linux"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-march=native -O2 -g"
      }
    },
    {
      "name": "windows",
      "inherits": "base-multi",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "targets": "all"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "targets": "all"
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux-relwithdebinfo",
      "targets": "all"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "targets": [
        "all"
      ]
    },
    {
      "name": "windows-release",
      "configurePreset": "windows",
      "configuration": "Release",
      "targets": [
        "all"
      ]
    },
    {
      "name": "windows-relwithdebinfo",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "targets": [
        "all"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base-test",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-relwithdebinfo",
      "inherits": "base-test",
      "configurePreset": "linux-relwithdebinfo"
    },
    {
      "name": "linux-release",
      "inherits": "base-test",
      "configurePreset": "linux-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "test-debug-linux",
      "steps": [
        {
          "type": "configure",
          "name": "linux-debug"
        },
        {
          "type": "build",
          "name": "linux-debug"
        },
        {
          "type": "test",
          "name": "linux-debug"
        }
      ]
    },
    {
      "name": "test-relwithdebinfo",
      "steps": [
        {
          "type": "configure",
          "name": "linux-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "linux-relwithdebinfo"
        },
        {
          "type": "test",
          "name": "linux-relwithdebinfo"
        }
      ]
    },
    {
      "name": "test-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        },
        {
          "type": "test",
          "name": "linux-release"
        }
      ]
    }
  ]
}
